# Optional raid shortcuts stay off.
# Keep the beta data diagnostics visible without unbounded disk growth.
Appender.DBErrors = 2,2,0,DBErrors.log,w,16777216,3
Appender.Playerbot = 2,3,1,Playerbot.log,w,16777216,3
