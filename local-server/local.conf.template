Playerbot.Bg.AutoJoin = 1
Playerbot.Bg.AutoSeed.Matches = 1
Playerbot.Bg.AutoSeed.Arena = 0
Bots.Reserve = 200
Bots.ActiveCap = 60
Bots.PerZone = 15-25
Bots.InCity = 30
Bots.DayRhythm = 0
Playerbot.ChatModel.Enable = 0
Playerbot.Cast.Enable = 0
Playerbot.Behavior.RaidGear = 0
Playerbot.Gear.RaidEnchants = 0
Playerbot.Gear.Owned.MatchOwner = 1
Playerbot.Gear.Owned.OwnerSlack = 0
Playerbot.OwnedGear.AllowedModes = "match"
Playerbot.World.Gear.EpicPercent = 0
Playerbot.Raid.ResistGear = 0
Playerbot.Raid.OnyxiaCloak = 0
Instance.IgnoreRaid = 0
Instance.IgnoreAttunement = 0
Instance.AhnQirajGatesOpen = 0
Instance.MoltenCoreSkipRunes = 0
Instance.MoltenCoreRagnarosReady = 0
AuctionHouseBot.Seller.Enabled = 1
AuctionHouseBot.Buyer.Enabled = 1
AuctionHouseBot.Buyer.Alliance.Enabled = 1
